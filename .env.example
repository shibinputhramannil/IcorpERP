# Database Configuration
POSTGRES_DB=icorp_erp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
HOST_DB_PORT=5433

# Django Configuration
SECRET_KEY=django-insecure-phase6-production-docker-secret-key-99
DEBUG=True

# Network and Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
