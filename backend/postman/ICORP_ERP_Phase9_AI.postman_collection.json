          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/companies/{{company_id}}/ai/customer-lookup/?q=Acme",
          "host": ["{{base_url}}"],
          "path": ["api", "companies", "{{company_id}}", "ai", "customer-lookup", ""],
          "query": [{ "key": "q", "value": "Acme" }]
        }
      }
    },
