{
  "info": {
    "_postman_id": "icorp-erp-phase5d-purchase-finalization-reporting",
    "name": "ICORP ERP - Phase 5D Purchase Finalization, Reporting & Financial Integration Collection",
    "description": "Comprehensive Postman test suite for ICORP ERP Phase 5D: Purchase Dashboard Finalization (AP KPIs), Purchase Analytics (12-Month Trends & Rates), Purchase Reports Suite (Summary, Orders, Vendors, Receiving, Financial), Vendor Purchase History, Purchase Invoices (Vendor Bills), and Supplier Payments (AP Disbursements).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "company_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "vendor_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "invoice_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "payment_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Authentication - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "var token = jsonData.access || (jsonData.tokens && jsonData.tokens.access);",
              "pm.expect(token).to.not.be.undefined;",
              "pm.collectionVariables.set('access_token', token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login/",
          "host": ["{{base_url}}"],
          "path": ["auth", "login", ""]
        }
      }
    },
    {
      "name": "02. Purchase Dashboard Finalization (AP & Operational KPIs)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Dashboard contains metrics and AP figures', function () {",
              "    pm.expect(jsonData).to.have.property('metrics');",
              "    pm.expect(jsonData.metrics).to.have.property('total_purchase_value');",
              "    pm.expect(jsonData.metrics).to.have.property('total_invoiced_amount');",
              "    pm.expect(jsonData.metrics).to.have.property('total_paid_amount');",
              "    pm.expect(jsonData.metrics).to.have.property('total_outstanding_amount');",
              "    pm.expect(jsonData).to.have.property('recent_invoices');",
              "    pm.expect(jsonData).to.have.property('recent_payments');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/companies/{{company_id}}/purchases/dashboard/",
          "host": ["{{base_url}}"],
          "path": ["companies", "{{company_id}}", "purchases", "dashboard", ""]
        }
      }
    },
    {
      "name": "03. Purchase Analytics (12-Month Trends & Fulfillment/Payment Rates)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Analytics has trends and distribution data', function () {",
              "    pm.expect(jsonData).to.have.property('monthly_trends');",
              "    pm.expect(jsonData.monthly_trends).to.be.an('array').with.lengthOf(12);",
              "    pm.expect(jsonData).to.have.property('ordered_vs_received');",
              "    pm.expect(jsonData.ordered_vs_received).to.have.property('fulfillment_rate_percentage');",
              "    pm.expect(jsonData).to.have.property('financial_overview');",
              "    pm.expect(jsonData.financial_overview).to.have.property('payment_rate_percentage');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
