        "url": {
          "raw": "{{base_url}}/companies/{{company_id}}/purchases/invoices/?status=ALL",
          "host": ["{{base_url}}"],
          "path": ["companies", "{{company_id}}", "purchases", "invoices", ""],
          "query": [
            {
              "key": "status",
              "value": "ALL"
            }
          ]
        }
