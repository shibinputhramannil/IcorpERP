    {
      "name": "09. Create Purchase Invoice from Purchase Order",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Generated invoice has PINV prefix and balance due', function () {",
              "    pm.expect(jsonData.invoice_number).to.include('PINV-');",
              "    pm.expect(jsonData).to.have.property('balance_due');",
              "    pm.collectionVariables.set('invoice_id', jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vendor_invoice_number\": \"BILL-PM-001\",\n  \"invoice_date\": \"2026-09-18\",\n  \"notes\": \"Generated via Postman Phase 5D Suite\"\n}"
        },
