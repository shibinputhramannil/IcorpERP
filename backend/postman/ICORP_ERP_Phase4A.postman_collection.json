				},
				{
					"name": "Create Quotation with Items",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"var data = pm.response.json();",
									"pm.collectionVariables.set(\"quotation_id\", data.id);",
