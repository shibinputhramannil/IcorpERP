									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var data = pm.response.json();",
									"if (Array.isArray(data) && data.length > 0) {",
									"    pm.collectionVariables.set(\"quotation_id\", data[0].id);",
									"}"
								],
								"type": "text/javascript"
