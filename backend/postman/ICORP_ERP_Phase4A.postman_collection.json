							"path": [
								"companies",
								"{{company_id}}",
								"sales",
								"quotations",
								"{{quotation_id}}",
								"convert",
								""
							]
						}
					}
				},
				{
					"name": "Prevent Duplicate Quotation Conversion",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Duplicate convert rejected with 400\", function () {",
									"    pm.response.to.have.status(400);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/companies/{{company_id}}/sales/quotations/{{quotation_id}}/convert/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"companies",
								"{{company_id}}",
								"sales",
								"quotations",
								"{{quotation_id}}",
								"convert",
								""
							]
						}
					}
				}
			]
		},
