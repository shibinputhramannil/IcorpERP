				{
					"name": "Atomic Convert Quotation to Order",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"var data = pm.response.json();",
									"pm.collectionVariables.set(\"order_id\", data.id);",
									"pm.test(\"Created Sales Order is CONFIRMED\", function () {",
									"    pm.expect(data.status).to.eql(\"CONFIRMED\");",
									"    pm.expect(data.order_number).to.include(\"SO-\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
