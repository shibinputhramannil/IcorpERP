						"url": {
							"raw": "{{base_url}}/companies/{{company_id}}/sales/quotations/{{quotation_id}}/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"companies",
								"{{company_id}}",
								"sales",
								"quotations",
								"{{quotation_id}}",
								""
