      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/companies/{{company_id}}/reports/executive/?date_from=2026-01-01&date_to=2026-12-31",
          "host": ["{{base_url}}"],
          "path": ["api", "companies", "{{company_id}}", "reports", "executive", ""],
