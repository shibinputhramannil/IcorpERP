      "name": "1. AI Chat - Month's Sales",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"What are this month's sales?\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/companies/{{company_id}}/ai/chat/",
          "host": ["{{base_url}}"],
          "path": ["api", "companies", "{{company_id}}", "ai", "chat", ""]
        }
      }
