									"});",
									"var data = pm.response.json();",
									"var orderNum = pm.collectionVariables.get(\"order_number\");",
									"var matching = data.filter(function(tx) {",
									"    return tx.transaction_type === 'STOCK_OUT' && (tx.reference || '').indexOf(orderNum) !== -1;",
									"});",
									"pm.test(\"STOCK_OUT ledger entry found with order reference\", function () {",
									"    pm.expect(matching.length).to.be.above(0);",
