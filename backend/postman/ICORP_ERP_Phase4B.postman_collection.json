		{
			"name": "3. Sales Order & Reservation Lifecycle",
			"item": [
				{
					"name": "Create Sales Order with Fulfillment Warehouse",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"var data = pm.response.json();",
									"pm.collectionVariables.set(\"order_id\", data.id);",
									"pm.collectionVariables.set(\"order_number\", data.order_number);",
									"pm.test(\"Order created with DRAFT status\", function () {",
									"    pm.expect(data.status).to.eql(\"DRAFT\");",
									"    pm.expect(data.warehouse).to.eql(parseInt(pm.collectionVariables.get(\"warehouse_id\")));",
									"    pm.expect(data.reservation_status).to.eql(\"NONE\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
