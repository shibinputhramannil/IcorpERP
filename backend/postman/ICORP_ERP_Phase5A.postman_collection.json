{
  "info": {
    "_postman_id": "icorp-erp-phase5a-purchase-management-foundation",
    "name": "ICORP ERP - Phase 5A Purchase Management Foundation Collection",
    "description": "Comprehensive Postman test suite for ICORP ERP Phase 5A: Purchase Quotations, Quotation Items, Purchase Orders, Order Items, Quotation-to-Order Conversion with Duplicate Prevention, Purchase Dashboard Foundation, Vendor Purchase History, and Multi-Tenant Isolation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "company_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "vendor_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "product_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "warehouse_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "quotation_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Authentication - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Has access token\", function () { pm.expect(jsonData.access || jsonData.tokens.access).to.be.a('string'); });",
              "pm.collectionVariables.set(\"access_token\", jsonData.access || jsonData.tokens.access);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "login",
            ""
          ]
        }
      }
    },
    {
      "name": "02. Purchase Dashboard - Metrics",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "pm.test(\"Contains metrics\", function () { pm.expect(jsonData.metrics).to.have.property('total_purchase_quotations'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/companies/{{company_id}}/purchases/dashboard/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "companies",
            "{{company_id}}",
            "purchases",
            "dashboard",
            ""
          ]
        }
      }
    },
    {
      "name": "03. Create Purchase Quotation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
              "var jsonData = pm.response.json();",
              "pm.expect(jsonData.quotation_number).to.match(/^PQT-\\d{4}-\\d{6}$/);",
              "pm.collectionVariables.set(\"quotation_id\", jsonData.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vendor\": {{vendor_id}},\n  \"quotation_date\": \"2026-09-17\",\n  \"valid_until\": \"2026-10-17\",\n  \"notes\": \"Postman procurement quotation\",\n  \"items\": [\n    {\n      \"product\": {{product_id}},\n      \"description\": \"Component Batch A\",\n      \"quantity\": \"10.00\",\n      \"unit_price\": \"120.00\",\n      \"discount\": \"20.00\",\n      \"tax\": \"10.00\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/companies/{{company_id}}/purchases/quotations/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "companies",
            "{{company_id}}",
            "purchases",
            "quotations",
            ""
          ]
        }
      }
    },
